{
  "version": "0.2.0",
  "configurations": [
    {
      "name": ".NET Core Launch (Local)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "dotnet build",
      "program": "${workspaceFolder}/src/bin/Debug/net10.0/HubMeteorologico.Api.dll",
      "args": [],
      "cwd": "${workspaceFolder}/src",
      "envFile": "${workspaceFolder}/config/.env",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      }
    },
  ]
}
